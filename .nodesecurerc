{
  "version": "1.0.0",
  "i18n": "english",
  "strategy": "npm",
  "ci": {
    "reporters": ["console"],
    "vulnerabilities": {
      "severity": "medium"
    },
    "warnings": {
      "obfuscated-code": "error",
      "unsafe-regex": "off",
      "suspicious-literal": "off",
      "unsafe-import": "off",
      "unsafe-assign": "off",
      "unsafe-stmt": "off"
    }
  }
}