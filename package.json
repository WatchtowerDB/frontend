{
  "name": "watchtower-frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=26.2.0",
    "npm": ">=11.14.0"
  },
  "engineStrict": true,
  "scripts": {
